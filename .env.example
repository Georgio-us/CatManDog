# Server - set in Railway, never commit real values
DATABASE_URL=
ORDERS_ENABLED=false
PAYMENTS_ENABLED=false
SOURCE_ON_DEMAND_PAYMENT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ACCOUNTS_ENABLED=false
SUPPORT_ENABLED=false
SUPPORT_INBOX=support@catmandog.es
SUPPORT_STAFF_EMAIL=support@catmandog.es
ADMIN_TOKEN=
PUBLIC_BASE_URL=https://catmandog.es/
RESEND_API_KEY=
RESEND_FROM=
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_VISIT_ALERTS_ENABLED=false

# Sendcloud API - server-side shipping quotes for measured parcels
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# Keep national payment off until real package dimensions, carrier service and VAT are checked
NATIONAL_CHECKOUT_ENABLED=false

# R2 migration - upload from a trusted local shell only
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://img.catmandog.es
R2_MEDIA_REDIRECT_ENABLED=true

# Weekly private PostgreSQL backup in a separate R2 bucket
BACKUP_ENABLED=false
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
