# Separate Railway service and a separate, empty PostgreSQL database
APP_ENV=staging
STAGING_DATABASE_URL=
PUBLIC_BASE_URL=https://staging.example.com/
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# Stripe test mode only; create a webhook endpoint for this staging URL
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ORDERS_ENABLED=true
PAYMENTS_ENABLED=true
SOURCE_ON_DEMAND_PAYMENT_ENABLED=true

# No live messages, accounts, carrier bookings or backup jobs
ACCOUNTS_ENABLED=false
SUPPORT_ENABLED=false
BACKUP_ENABLED=false
NATIONAL_CHECKOUT_ENABLED=false
TELEGRAM_VISIT_ALERTS_ENABLED=false
